        if rand_num == 1:
            data[row,0:15] = X_W[row]  #fill each column within the row with the X_W data first
            data[row,15:30]= X_L[row]  #fill each column within the row with the X_L data next
        else:
            data[row,0:15] = X_L[row]    #fill each column within the row with the X_L data first
            data[row,15:30] = X_W[row]  #fill each column within the row with the X_W data next
        labels[row,0] = rand_num 
    
